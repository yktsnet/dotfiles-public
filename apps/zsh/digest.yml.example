# コピー先: 自分のリポジトリの .github/workflows/digest.yml
# 必要な secrets: ANTHROPIC_API_KEY / TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
name: Daily Hatena & GitHub Digest

on:
  schedule:
    - cron: '0 14 * * *' # UTC 14:00 ＝ JST 23:00
  workflow_dispatch: # 手動起動ボタンを有効化

jobs:
  digest:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Restore last URLs cache
        uses: actions/cache@v4
        with:
          path: ~/.local/share/hatebu
          key: hatebu-last-urls-${{ github.run_id }}
          restore-keys: |
            hatebu-last-urls-

      - name: Run Hatena & GitHub Digest Scripts
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          python apps/zsh/hatenadigest.py
          python apps/zsh/githubtrending.py
