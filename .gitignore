# Nix
result
result-*
.direnv/

# AIエージェント (Claude / Jules)
# 公開リポのため harness（settings.json / skills / CLAUDE.md / context / issues）は追跡する。
# 個人ローカル上書きのみ無視。
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# 永続メモリの実体（user個人の事実、memory.nixがsymlinkを張る）
memory/

# sops（実体は非公開。.sops.yaml.example と secrets/.gitkeep は追跡する）
.sops.yaml
secrets/**/*.age

# マスク辞書の復号先（secrets-agents.nix が secrets/agents/*.age をここへ平文で復号する）。
# production-server.md は既に追跡済みのサンプルで、追跡済みファイルはこのルールの影響を受けない。
secrets-agents/*

# エディタ一時ファイル
.vscode/
.idea/
*.swp
*~
.DS_Store
