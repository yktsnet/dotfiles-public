{
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(nix flake check *)",
      "Bash(nix flake check)",
      "Bash(nix fmt *)",
      "Bash(nix eval *)",
      "Bash(zsh -n *)"
    ],
    "deny": [
      "Bash(ssh *)",
      "Bash(nixos-rebuild *)",
      "Bash(darwin-rebuild *)",
      "Bash(home-manager switch *)",
      "Bash(nh *)",
      "Bash(nix flake update *)",
      "Edit(flake.lock)",
      "Edit(secrets-agents/**)",
      "Read(secrets-agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-non-nix-install.sh",
            "timeout": 10,
            "statusMessage": "Nix 外インストールを検査中"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-live-claude-config-edit.sh",
            "timeout": 10,
            "statusMessage": "~/.claude 直接編集を検査中"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/route-browser-to-crit.sh",
            "timeout": 10,
            "statusMessage": "ブラウザ起動を crit live へ回すか検査中"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-branch-in-checkout.sh",
            "timeout": 10,
            "statusMessage": "元のチェックアウトでのブランチ操作を検査中"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-memory-write.sh",
            "timeout": 10,
            "statusMessage": "memory の書き込み承認を確認中"
          }
        ]
      },
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-new-skill-md.sh",
            "timeout": 10,
            "statusMessage": "新規SKILL.md作成を検査中"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-live-claude-config-edit.sh",
            "timeout": 10,
            "statusMessage": "~/.claude 直接編集を検査中"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-project-scoped-memory.sh",
            "timeout": 10,
            "statusMessage": "memory の書き込み先を検査中"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/backup-secret-json.sh",
            "timeout": 10,
            "statusMessage": "secret上書き前にバックアップ中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/static-check.sh",
            "timeout": 20,
            "statusMessage": "編集したファイルを構文チェック中"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/opus-scope-and-concision.sh",
            "timeout": 10,
            "statusMessage": "Opus向け簡潔性指示を注入中"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jp-proofread-stop.sh",
            "timeout": 10,
            "statusMessage": "書いた日本語の校正を裏で起動中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jp-proofread-notice.sh",
            "timeout": 10,
            "statusMessage": "裏の校正の結果を確認中"
          }
        ]
      }
    ]
  }
}
